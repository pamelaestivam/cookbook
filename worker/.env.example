# Supabase project settings -> API. The service role key bypasses row level
# security, so keep it on the server only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Claude API key from https://platform.claude.com
ANTHROPIC_API_KEY=

# Optional
# CLAUDE_MODEL=claude-opus-5-5
# WHISPER_MODEL=small           # faster-whisper model for videos without captions
# MAX_VIDEO_MINUTES=45
# WORKER_CONCURRENCY=2
# YTDLP_COOKIES_FILE=/run/secrets/cookies.txt   # for Instagram/TikTok posts that need a login
