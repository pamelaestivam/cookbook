# Copy this file to .env and fill in the two secrets. Never commit .env.

SUPABASE_URL=https://elckmwdxjcrohxydgsiz.supabase.co
# Supabase dashboard -> Project Settings -> API Keys -> secret key (sb_secret_...)
# or the legacy service_role key. It bypasses row level security: keep it private.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API key from https://platform.claude.com -> API Keys
ANTHROPIC_API_KEY=

# Optional
# YTDLP_COOKIES_FROM_BROWSER=chrome   # use your browser's logins for Instagram/TikTok posts that need one
# YTDLP_COOKIES_FILE=/path/to/cookies.txt
# CLAUDE_MODEL=claude-opus-5-5
# WHISPER_MODEL=small                  # speech-to-text for videos without captions
# MAX_VIDEO_MINUTES=45
# WORKER_CONCURRENCY=2
