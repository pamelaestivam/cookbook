# Copy this file to .env and fill in the two keys. Never commit .env or share it.

SUPABASE_URL=https://elckmwdxjcrohxydgsiz.supabase.co
# Supabase dashboard -> Project Settings -> API Keys -> secret key (sb_secret_...).
# It bypasses row level security: keep it private.
SUPABASE_SERVICE_ROLE_KEY=

# Free Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional
# GEMINI_MODEL=gemini-flash-latest
# YTDLP_COOKIES_FROM_BROWSER=chrome   # use your browser's logins for Instagram/TikTok posts that need one
# YTDLP_COOKIES_FILE=/path/to/cookies.txt
# PYTHON=py                           # Python command; defaults to "py" on Windows, "python3" elsewhere
# MAX_VIDEO_MINUTES=20
# WORKER_CONCURRENCY=1
